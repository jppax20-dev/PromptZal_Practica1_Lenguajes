@modelo "gpt-4-turbo"
@rol "traductor"
@formato "lista"

AGENTE procesador {
    contexto = "Traductor experto" + " " + "nivel 5"
    
    $
    
    variable archivo = CARGAR("documento.txt")
    
    EXTRAER "nombres" SOBRE archivo -> listaNombres
    
    ?
    
    /* 
       Comentarios con simbolos ignorados
       @ # ~ \ ^ 
    */
    
    TRADUCIR listaNombres EN "frances" COMO "lista" -> listaTraducida
    
    |
    
    RESUMIR listaTraducida EN 25 palabras -> resumen
    
    °
    
    EJECUTAR procesador
    EXPORTAR resumen
}
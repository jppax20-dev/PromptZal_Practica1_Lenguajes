digraph AFD_PromptZal {
    rankdir=LR;
    nodesep=0.8;
    ranksep=1.2;
    dpi=200;
    concentrate=true;
    splines=polyline;
    node [shape=circle, fontname="Helvetica", fontsize=12, style=filled, fillcolor=white, color=black];
    edge [fontname="Helvetica", fontsize=11, fontcolor=blue, color=gray30];

    inicio [shape=point, width=0];
    inicio -> q0;

    q1 [shape=doublecircle, label="q1\nIDENTIFICADOR"];
    q3 [shape=doublecircle, label="q3\nDIRECTIVA"];
    q4 [shape=doublecircle, label="q4\nENTERO"];
    q6 [shape=doublecircle, label="q6\nDECIMAL"];
    q8 [shape=doublecircle, label="q8\nCADENA"];
    q9 [shape=doublecircle, label="q9\nOP_ASIGNACION"];
    q10 [shape=doublecircle, label="q10\nOP_CONCATENACION"];
    q12 [shape=doublecircle, label="q12\nCONECTOR"];
    q17 [shape=doublecircle, label="q17\nDELIMITADOR"];
    q18 [shape=doublecircle, label="q18\nDELIMITADOR"];
    q19 [shape=doublecircle, label="q19\nDELIMITADOR"];
    q20 [shape=doublecircle, label="q20\nDELIMITADOR"];
    qerr [shape=circle];

    q0 -> q1 [label="   L   "];
    q1 -> q1 [label="   L   "];
    q1 -> q1 [label="   D   "];
    q0 -> q2 [label="   @   "];
    q2 -> q3 [label="   L   "];
    q3 -> q3 [label="   L   "];
    q3 -> q3 [label="   D   "];
    q0 -> q4 [label="   D   "];
    q4 -> q4 [label="   D   "];
    q4 -> q5 [label="   .   "];
    q5 -> q6 [label="   D   "];
    q6 -> q6 [label="   D   "];
    q0 -> q7 [label="   \"   "];
    q7 -> q7 [label="   C   "];
    q7 -> q8 [label="   \"   "];
    q0 -> q9 [label="   =   "];
    q0 -> q10 [label="   +   "];
    q0 -> q11 [label="   -   "];
    q11 -> q12 [label="   >   "];
    q0 -> q17 [label="   {   "];
    q0 -> q18 [label="   }   "];
    q0 -> q19 [label="   (   "];
    q0 -> q20 [label="   )   "];
    q0 -> q13 [label="   /   "];
    q13 -> q14 [label="   /   "];
    q14 -> q14 [label="   N   "];
    q14 -> q0 [label="   \\n   "];
    q13 -> q15 [label="   *   "];
    q15 -> q15 [label="   B   "];
    q15 -> q16 [label="   *   "];
    q16 -> q16 [label="   *   "];
    q16 -> q15 [label="   B   "];
    q16 -> q0 [label="   /   "];
    q0 -> q0 [label="   esp   "];
    q0 -> q0 [label="   \\n   "];
    q2 -> qerr [label="   otro   "];
    q5 -> qerr [label="   otro   "];
    q7 -> qerr [label="   \\n   "];
    q11 -> qerr [label="   otro   "];
    q13 -> qerr [label="   otro   "];
    q0 -> qerr [label="   otro   "];
    q1 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q3 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q4 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q6 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q8 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q9 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q10 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q12 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q17 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q18 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q19 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
    q20 -> q0 [label="   fin token   ", style=solid, color=gray50, fontcolor=gray50];
}
